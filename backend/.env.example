# Copy to .env and fill in. Nothing here is a real value.
# .env is gitignored and must stay that way.
#
# Read by the apps. The database container's own credentials live in the
# .env.example next to docker-compose.yml, because compose reads those and the
# apps never see them.

# --- Databases ----------------------------------------------------------
# The password has to be hex. openssl rand -base64 emits / and +, and a / reads
# as the end of the credentials here, so the parser then looks for a port in the
# wrong place and Prisma reports P1013 invalid port number
#
# localhost because compose publishes the ports to the host machine
# Running the apps inside compose instead means the host is the service name
DATABASE_URL=postgresql://oathgate:YOUR_HEX_PASSWORD@localhost:5432/oathgate?schema=public

# Notifications keeps its own database and never joins to the gateway's
# It learns what happened from events, the same as any outside consumer would
NOTIFICATIONS_DATABASE_URL=postgresql://oathgate:YOUR_HEX_PASSWORD@localhost:5432/oathgate_notifications?schema=public

# --- Redis --------------------------------------------------------------
# The job queue and the event channel
REDIS_URL=redis://localhost:6379

# --- Secrets ------------------------------------------------------------
# 32 bytes of hex, which is what AES-256-GCM wants
# GCM encrypts and also produces a tag proving the ciphertext was not altered
# Webhook signing secrets are stored encrypted with this, so losing it means
# every endpoint has to be given a new secret
#   openssl rand -hex 32
WEBHOOK_SECRET_KEY=YOUR_64_HEX_CHARACTERS

# --- Bitcoin ------------------------------------------------------------
# An account level public key exported at m/84'/1'/0', so this server can build
# a fresh receive address per payment and can never spend anything
# Signet and testnet share these version bytes and both give tb1q addresses
BTC_XPUB_TEST=YOUR_VPUB_OR_TPUB

# Left empty, and asking for a live payment stops with a 503 rather than
# deriving a signet address for real money
BTC_XPUB_LIVE=

# Which chain the worker asks about
# The addresses look identical on signet and testnet, so pointing this at the
# wrong one is silent: payments simply never arrive
BLOCKSTREAM_API_URL=https://blockstream.info/signet/api

# --- Api ----------------------------------------------------------------
NODE_ENV=development
PORT=5002

# Exact origin of the dashboard, scheme included and no trailing slash
# Comma separated for more than one
# The session cookie only travels if this matches, so a mismatch shows up as
# every dashboard call failing at once
DASHBOARD_ORIGIN=http://localhost:3000

# --- Optional -----------------------------------------------------------
# Raises the rate limit on the price lookup. Without it the free tier is used
COINGECKO_API_KEY=

# Turns a typed sentence into a payments filter. Leave it empty and the search
# box still works, it just matches the text literally
GROQ_API_KEY=

# Free tier models get retired, and the boot log names the ones on offer when
# this one has gone. Changing it is a restart, never a code change
GROQ_MODEL=llama-3.3-70b-versatile

# Read only by npm run seed, which creates one merchant and prints one api key
SEED_MERCHANT_EMAIL=
SEED_MERCHANT_PASSWORD=

# Without these the notifications service still consumes events and marks them
# handled, it just does not send anything
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
