{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    // Relative, and no baseUrl. baseUrl is deprecated from TypeScript 7, and
    // without it a path target has to start with ./ so it resolves against this
    // file rather than an implied root
    "paths": {
      "@app/shared": ["./libs/shared/src"],
      "@app/shared/*": ["./libs/shared/src/*"]
    }
  }
}
