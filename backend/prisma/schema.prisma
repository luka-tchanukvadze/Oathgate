generator client {
  provider = "prisma-client"
  output   = "../libs/shared/src/generated/prisma"

  // The generator emits ESM by default and this app compiles to CommonJS, which
  // showed up as import.meta.url landing inside a require() file
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Money rules for this file. Every amount is a whole number in the currency's
// smallest unit, 10.50 GEL is 1050, and always sits next to its own currency.
// Decimal(38, 0) rather than BigInt because BigInt overflows around 9 ETH.
// Timestamps are Timestamptz, Prisma's default DateTime has no timezone

enum PaymentStatus {
  PENDING
  CONFIRMING
  PAID
  UNDERPAID
  EXPIRED
  REVERSED
  FAILED
}

// Test rows and live rows never mix in a query
enum KeyMode {
  TEST
  LIVE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

// A merchant balance is money I owe, not money I hold
enum AccountKind {
  MERCHANT_BALANCE
  GATEWAY_WALLET
  FEES
}

model Merchant {
  id    String @id @default(uuid(7)) @db.Uuid
  email String @unique
  name  String

  // argon2id, not SHA-256 like the API keys. A key is random bytes I look up by
  // hash, a password is a human word I only ever compare against one known row
  passwordHash String

  settlementCurrency String @db.VarChar(10)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  payments          Payment[]
  accounts          Account[]
  apiKeys           ApiKey[]
  idempotencyKeys   IdempotencyKey[]
  sessions          MerchantSession[]
  webhookEndpoints  WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]

  @@map("merchant")
}

model Payment {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  // Null when the dashboard created it with a session cookie, not a key
  apiKeyId String? @db.Uuid
  apiKey   ApiKey? @relation(fields: [apiKeyId], references: [id])

  // Copied off the key, not joined to it. A payment must never become ambiguous
  // about whether it was real money, and keys get revoked
  mode KeyMode

  // Their order number, not mine. I never interpret it
  reference String? @db.VarChar(64)

  fiatAmount   Decimal @db.Decimal(38, 0)
  fiatCurrency String  @db.VarChar(10)

  cryptoAmount   Decimal @db.Decimal(38, 0)
  cryptoCurrency String  @db.VarChar(10)

  // A rate is a ratio, not money, so this one keeps decimal places. Still
  // Decimal and never Float
  quotedRate Decimal @db.Decimal(38, 18)

  address         String
  // Which index I derived the address at, so I can rebuild it from the xpub
  derivationIndex Int

  status    PaymentStatus @default(PENDING)
  expiresAt DateTime      @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  chainTxs      ChainTx[]
  ledgerEntries LedgerEntry[]

  @@unique([address])
  @@index([status, expiresAt])
  @@index([merchantId, mode, createdAt])
  // Not unique. One order can need a second payment after the first expires
  @@index([merchantId, mode, reference])
  @@map("payment")
}

// One row per transaction seen on chain. Its own table because one address can
// receive several transactions, so underpaid and overpaid fall out of a SUM
// instead of needing special cases
model ChainTx {
  id        String  @id @default(uuid(7)) @db.Uuid
  paymentId String  @db.Uuid
  payment   Payment @relation(fields: [paymentId], references: [id])

  txid String

  // Null until mined. Kept so I can spot a reorg: if the chain later disagrees
  // about this block, the payment is not real
  blockHash String?

  amount   Decimal @db.Decimal(38, 0)
  currency String  @db.VarChar(10)

  confirmations Int @default(0)

  seenAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // The worker polls in a loop and will see the same tx every time. Without
  // this, each poll inserts another row and the SUM double-credits
  @@unique([txid, paymentId])
  @@index([paymentId])
  @@map("chain_tx")
}

// Cached projection, NOT the truth. The truth is the sum of this account's
// ledger entries, and I have to be able to rebuild this column from them
model Account {
  id String @id @default(uuid(7)) @db.Uuid

  // Null on a house account, which is the far side of every merchant movement.
  // Restrict, because the optional-relation default is SET NULL and that would
  // turn a merchant's balance into an ownerless row
  merchantId String?   @db.Uuid
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  kind AccountKind

  currency String  @db.VarChar(10)
  mode     KeyMode

  balance Decimal @default(0) @db.Decimal(38, 0)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  entries LedgerEntry[]

  // The row I lock with SELECT ... FOR UPDATE when settling. NULLs count as
  // distinct, so the house rows need a partial index instead
  @@unique([merchantId, currency, mode, kind])
  @@map("account")
}

// Append only. Never UPDATE, never DELETE. To undo a reorg or a refund I write
// a new pair that cancels the old one and points back at it
model LedgerEntry {
  id String @id @default(uuid(7)) @db.Uuid

  // Both halves of one movement share this, and a group must sum to zero
  transferId String @db.Uuid

  accountId String  @db.Uuid
  account   Account @relation(fields: [accountId], references: [id])

  // Always positive. Direction carries the sign so it cannot go missing
  direction EntryDirection
  amount    Decimal        @db.Decimal(38, 0)
  currency  String         @db.VarChar(10)

  paymentId String?  @db.Uuid
  payment   Payment? @relation(fields: [paymentId], references: [id])

  // Unique because an entry can only be reversed once
  reversesId String?      @unique @db.Uuid
  reverses   LedgerEntry? @relation("EntryReversal", fields: [reversesId], references: [id])
  reversedBy LedgerEntry? @relation("EntryReversal")

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([accountId, createdAt])
  @@index([transferId])
  @@index([paymentId])
  @@map("ledger_entry")
}

model ApiKey {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  // SHA-256 hex, not bcrypt. A random salt would mean no index and a table scan
  keyHash   String @unique @db.Char(64)
  // Plain, like sk_test_a1b2c3d4. The full key is shown once and never again
  keyPrefix String @db.VarChar(24)

  mode KeyMode
  name String

  lastUsedAt DateTime? @db.Timestamptz(3)

  // Revoking never deletes
  // Payments made with this key still need explaining afterwards
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  payments Payment[]

  @@index([merchantId, mode])
  @@map("api_key")
}

// Rows go in the same transaction as the ledger, so a crash cannot lose an event
model OutboxEvent {
  id String @id @default(uuid(7)) @db.Uuid

  // Columns, not payload fields, so a consumer can route without parsing JSON
  aggregateType String @db.VarChar(40)
  aggregateId   String @db.Uuid
  eventType     String @db.VarChar(60)

  // Same reasoning, one step further. The relay has to find this merchant's
  // endpoints in this mode, and a required routing field buried in JSON is one
  // the database cannot enforce
  merchantId String  @db.Uuid
  mode       KeyMode

  payload Json @db.JsonB

  // Null means not published yet, which is what the relay polls for
  publishedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  webhookDeliveries WebhookDelivery[]

  @@index([publishedAt, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_event")
}

// Dashboard login. A row rather than a signed token, so I can revoke one
model MerchantSession {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  // SHA-256 of what is in the cookie, same reasoning as the API keys
  tokenHash String @unique @db.Char(64)

  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([merchantId])
  @@index([expiresAt])
  @@map("merchant_session")
}

// Stops a retried request creating a second payment. First response is stored
// and replayed
model IdempotencyKey {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  key String @db.VarChar(255)

  // Same key and same body means replay. Same key with a different body means
  // the client has a bug, so that returns an error instead of someone else's
  // response
  requestHash String @db.Char(64)

  responseStatus Int
  responseBody   Json @db.JsonB

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)

  // Scoped to the merchant. Two merchants both sending "order-1" is normal
  @@unique([merchantId, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

// Where a merchant wants to be told. One per mode, because a shop points test
// and live at different servers
model WebhookEndpoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  mode KeyMode
  url  String @db.VarChar(2048)

  // Encrypted, not hashed. I have to read this back to sign every webhook, and
  // a hash is one way. Format is v1:iv:tag:ciphertext, all base64url, so the
  // key can be rotated later without guessing how old rows were written
  secretCiphertext String

  // Plain, so the dashboard can name a secret it can no longer show
  secretPrefix String @db.VarChar(24)

  // Empty means all of them
  events String[]

  // Disabling never deletes, because the delivery history still points here
  disabledAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@unique([merchantId, mode, url])
  @@index([merchantId, mode])
  @@map("webhook_endpoint")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD_LETTER
}

// One row per event per endpoint. The running state of trying to reach them
model WebhookDelivery {
  id         String   @id @default(uuid(7)) @db.Uuid
  merchantId String   @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id])

  endpointId String          @db.Uuid
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id])

  // The outbox row this came from. Unique with the endpoint below, so a relay
  // that runs twice cannot queue the same event to the same place twice
  outboxEventId String      @db.Uuid
  outboxEvent   OutboxEvent @relation(fields: [outboxEventId], references: [id])

  mode      KeyMode
  eventType String @db.VarChar(60)

  // The exact body that was signed. Retries have to send the same bytes, or the
  // merchant sees a different message each time under a valid signature
  payload Json @db.JsonB

  status   WebhookDeliveryStatus @default(PENDING)
  attempts Int                   @default(0)

  // A budget rather than a constant, because a manual replay raises it. Resetting
  // attempts to zero instead would collide with the attempt log's own numbering.
  // The default is only here for rows that already existed, the relay sets it
  maxAttempts Int @default(7)

  // Null when there is nothing more to try
  nextAttemptAt DateTime? @db.Timestamptz(3)
  deliveredAt   DateTime? @db.Timestamptz(3)

  lastResponseStatus Int?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  webhookAttempts WebhookAttempt[]

  @@unique([endpointId, outboxEventId])
  @@index([status, nextAttemptAt])
  // merchantId and mode are copied off the endpoint on purpose. Every dashboard
  // query filters on both, and this is the highest volume table in the system
  @@index([merchantId, mode, createdAt])
  @@map("webhook_delivery")
}

// One row per actual try. A counter on the delivery would say it failed four
// times without ever saying how
model WebhookAttempt {
  id         String          @id @default(uuid(7)) @db.Uuid
  deliveryId String          @db.Uuid
  delivery   WebhookDelivery @relation(fields: [deliveryId], references: [id])

  attempt Int

  // Null when nothing answered at all, which is a timeout or a dead host
  responseStatus Int?
  error          String? @db.VarChar(500)

  durationMs Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([deliveryId, attempt])
  @@index([deliveryId])
  @@map("webhook_attempt")
}
