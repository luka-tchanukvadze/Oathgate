// This service's own database
// Different connection string, different client, different migrations

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// The id is the gateway's event id, not one of mine
// As the primary key it makes a redelivery collide instead of arriving twice
model ReceivedEvent {
  id String @id @db.Uuid

  type       String @db.VarChar(60)
  merchantId String @db.Uuid

  // A string, not an enum
  // A consumer that refuses an unfamiliar value breaks the day one is added
  mode String @db.VarChar(10)

  payload Json @db.JsonB

  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  // Null until the email has gone out
  // That is what stops a redelivery sending a second copy
  processedAt DateTime? @db.Timestamptz(3)

  // A row that keeps failing shows up here, not only in a log I have lost
  attempts  Int     @default(0)
  lastError String? @db.VarChar(500)

  @@index([merchantId, receivedAt])
  @@index([processedAt])
  @@map("received_event")
}
