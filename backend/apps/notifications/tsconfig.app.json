{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    // rootDir is the repo root and not this app, because the app imports from
    // libs/ and TypeScript refuses to emit above its rootDir. Setting it here
    // rather than letting tsc infer it is what keeps the output path stable
    "rootDir": "../../",
    "outDir": "../../dist"
  },
  "include": ["src/**/*", "../../libs/**/*"],
  "exclude": ["node_modules", "dist", "**/*spec.ts"]
}
