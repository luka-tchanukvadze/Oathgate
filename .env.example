# Copy to .env and fill in. Nothing here is a real value.
# Read by docker compose, not by the apps. Their variables are in
# backend/.env.example.

# Postgres only reads these when its data directory is empty, so changing the
# password later needs docker compose down -v rather than an edit
POSTGRES_USER=oathgate
POSTGRES_DB=oathgate

# Hex, not base64. openssl rand -base64 emits / and +, and a / reads as the end
# of the credentials in a connection url, so the parser then looks for a port in
# the wrong place and Prisma reports P1013 invalid port number
#   openssl rand -hex 24
POSTGRES_PASSWORD=YOUR_HEX_PASSWORD
